# Copy to deploy/observability/.env.local, then replace every required blank value
# locally. This file is intentionally credential-free and safe to commit.

# Required before the first Langfuse bootstrap. Generate unique local values; do
# not reuse a production database password, SALT, or session secret.
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_DATABASE_URL=
LANGFUSE_DIRECT_URL=
LANGFUSE_SALT=
# Generate once with `openssl rand -hex 32`; web and worker must keep this value stable.
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_NEXTAUTH_URL=http://127.0.0.1:3001
# Project retention is an EE feature. Headless IDs are stable facts. Project
# keys must use Langfuse format: lf_pk_<random> and lf_sk_<random>; never commit them.
LANGFUSE_EE_LICENSE_KEY=
LANGFUSE_INIT_ORG_ID=longtermism-local
LANGFUSE_INIT_PROJECT_ID=longtermism-observability
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_REDIS_CONNECTION_STRING=
LANGFUSE_CLICKHOUSE_URL=
LANGFUSE_CLICKHOUSE_MIGRATION_URL=
# Use a dedicated local ClickHouse identity; both web and worker require it.
LANGFUSE_CLICKHOUSE_USER=langfuse
LANGFUSE_CLICKHOUSE_PASSWORD=
# Separate bootstrap-only ClickHouse administrator; never inject this into Langfuse.
LANGFUSE_CLICKHOUSE_ADMIN_PASSWORD=
# Langfuse v3 always writes raw events to S3-compatible storage. The local profile
# creates this bucket automatically in its private MinIO instance.
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_MINIO_ROOT_USER=
LANGFUSE_MINIO_ROOT_PASSWORD=
# Distinct non-root identity used by Langfuse for this bucket's events/ prefix.
LANGFUSE_MINIO_ACCESS_KEY_ID=langfuse-events
LANGFUSE_MINIO_SECRET_ACCESS_KEY=

# Required only for normal Grafana/Collector startup after a Langfuse project key
# exists. LANGFUSE_OTLP_AUTHORIZATION includes the Basic prefix; the ingestion
# version is a protocol value, not a secret.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
LANGFUSE_OTLP_AUTHORIZATION=
LANGFUSE_OTEL_INGESTION_VERSION=4
