# Copy to deploy/observability/.env.local, then replace every required blank value
# locally. This file is intentionally credential-free and safe to commit.

# Required before the first Langfuse bootstrap. Generate unique local values; do
# not reuse a production database password, SALT, or session secret.
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_DATABASE_URL=
LANGFUSE_DIRECT_URL=
LANGFUSE_SALT=
# Generate once with `openssl rand -hex 32`; web and worker must keep this value stable.
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_NEXTAUTH_URL=http://127.0.0.1:3001
LANGFUSE_REDIS_CONNECTION_STRING=
LANGFUSE_CLICKHOUSE_URL=
LANGFUSE_CLICKHOUSE_MIGRATION_URL=

# Required only for normal Grafana/Collector startup after a Langfuse project key
# exists. LANGFUSE_OTLP_AUTHORIZATION includes the Basic prefix; the ingestion
# version is a protocol value, not a secret.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
LANGFUSE_OTLP_AUTHORIZATION=
LANGFUSE_OTEL_INGESTION_VERSION=4
