# Real observability image matrix. Tags are deliberately pinned; do not use latest.
# Record immutable digests only after the first successful real-backend E2E.

# OpenTelemetry Collector Contrib v0.153.0 release:
# https://github.com/open-telemetry/opentelemetry-collector-releases/releases/tag/v0.153.0
OTELCOL_CONTRIB_IMAGE=otel/opentelemetry-collector-contrib:0.153.0

# Collector image is distroless, so the bounded volume-permission initializer
# uses a separate pinned utility image. It never runs the Collector process.
COLLECTOR_STORAGE_INIT_IMAGE=busybox:1.37.0

# Prometheus v3.11.0 release:
# https://github.com/prometheus/prometheus/releases/tag/v3.11.0
PROMETHEUS_IMAGE=prom/prometheus:v3.11.0

# Grafana Loki v3.7.2 release:
# https://github.com/grafana/loki/releases/tag/v3.7.2
LOKI_IMAGE=grafana/loki:3.7.2

# Grafana Tempo v2.10.5 release:
# https://github.com/grafana/tempo/releases/tag/v2.10.5
TEMPO_IMAGE=grafana/tempo:2.10.5

# Grafana v13.1.0 release. This upgrades the Tempo Explore frontend away from
# the v13.0.2 runtime crash while retaining a reproducible, non-latest pin.
# https://github.com/grafana/grafana/releases/tag/v13.1.0
GRAFANA_IMAGE=grafana/grafana:13.1.0

# Langfuse v3.185.0 release. The worker uses the matching official image tag:
# https://github.com/langfuse/langfuse/releases/tag/v3.185.0
LANGFUSE_IMAGE=langfuse/langfuse:3.185.0
LANGFUSE_WORKER_IMAGE=langfuse/langfuse-worker:3.185.0

# Langfuse self-host dependencies. These tags must move with a tested Langfuse
# compose profile rather than independently. Sources are their upstream releases.
# ClickHouse v26.4.4.38-stable: https://github.com/ClickHouse/ClickHouse/releases/tag/v26.4.4.38-stable
LANGFUSE_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.4.4.38
# PostgreSQL 17.10 release: https://www.postgresql.org/docs/release/17.10/
LANGFUSE_POSTGRES_IMAGE=postgres:17.10
# Redis 8.8.0 release: https://github.com/redis/redis/releases/tag/8.8.0
LANGFUSE_REDIS_IMAGE=redis:8.8.0
# MinIO server/client releases are pinned together for the local Langfuse event store.
# Verified against the upstream image manifests before profile integration.
LANGFUSE_MINIO_IMAGE=minio/minio:RELEASE.2025-03-12T18-04-18Z
LANGFUSE_MINIO_MC_IMAGE=minio/mc:RELEASE.2025-03-12T17-29-24Z

# SigNoz v0.126.0 release and its profile-local Collector image:
# https://github.com/SigNoz/signoz/releases/tag/v0.126.0
SIGNOZ_IMAGE=signoz/signoz:v0.126.0
SIGNOZ_OTELCOL_IMAGE=signoz/signoz-otel-collector:v0.126.0
# SigNoz uses the same independently pinned ClickHouse server family.
SIGNOZ_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.4.4.38
